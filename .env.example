# Copy to .env and fill in. Do NOT commit .env.
DOMAIN=kb.example.com
BASE_URL=kb.example.com

# Shared password protecting the entire site (see DEPLOY.md "Access control").
# Generate with:
#   docker run --rm httpd:2.4-alpine htpasswd -nbBC 12 familyuser 'YOUR_PASSWORD'
# Paste the full "user:hash" output below as-is (single $, no escaping needed here).
KB_AUTH_HTPASSWD=familyuser:$2y$12$REPLACE_WITH_GENERATED_HASH

# Security questions, checked alongside the password above — every question
# must be answered correctly to log in. JSON array of {"q": ..., "a": ...}
# pairs, as many as you want. Plain text (not hashed) — this file already
# isn't committed, so it's the same trust boundary as everything else here.
# Update this every ~3 months (see DEPLOY.md "Access control" for the
# rotation routine).
KB_SECURITY_QUESTIONS=[{"q":"REPLACE with a question only your people would know","a":"REPLACE"},{"q":"REPLACE with a second question","a":"REPLACE"}]

# Secret used to sign session cookies once someone logs in. Generate with:
#   openssl rand -hex 32
# Rotating this instantly logs everyone out (all existing session cookies
# stop verifying) — do this at the same time as rotating the questions above
# to force a fresh login each quarter.
KB_SESSION_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
