# Copy to .env and fill in. Do NOT commit .env.
#
# This file covers both deploy modes (see README.md / DEPLOY.md). You only
# need to fill in the block for whichever mode(s) you're actually running —
# `docker compose up` (public) only requires DOMAIN/BASE_URL/KB_*, and
# `docker compose -f docker-compose.local.yml up` (local) only requires
# PORT/NOTES_*. If you run both modes from the same .env, note that BASE_URL
# is shared between them (see its comment below).

# --- Public deployment (VPS + Traefik, password + security questions) ---

# Used by docker-compose.yml (Traefik host-matching rule).
DOMAIN=kb.example.com
# Cosmetic — baked into sitemap.xml/RSS links at build time. If you're also
# running the local deployment below from this same .env, BASE_URL is shared
# by both — set it to whichever mode you're actually deploying right now, or
# use a separate .env file per mode if you run both at once.
BASE_URL=kb.example.com

# Shared password protecting the entire site (see DEPLOY.md "Access control").
# Generate with:
#   docker run --rm httpd:2.4-alpine htpasswd -nbBC 12 familyuser 'YOUR_PASSWORD'
# Paste the full "user:hash" output below as-is (single $, no escaping needed here).
KB_AUTH_HTPASSWD=familyuser:$2y$12$REPLACE_WITH_GENERATED_HASH

# Security questions, checked alongside the password above — every question
# must be answered correctly to log in. JSON array of {"q": ..., "a": ...}
# pairs, as many as you want. Plain text (not hashed) — this file already
# isn't committed, so it's the same trust boundary as everything else here.
# Update this every ~3 months (see DEPLOY.md "Access control" for the
# rotation routine).
KB_SECURITY_QUESTIONS=[{"q":"REPLACE with a question only your people would know","a":"REPLACE"},{"q":"REPLACE with a second question","a":"REPLACE"}]

# Secret used to sign session cookies once someone logs in. Generate with:
#   openssl rand -hex 32
# Rotating this instantly logs everyone out (all existing session cookies
# stop verifying) — do this at the same time as rotating the questions above
# to force a fresh login each quarter.
KB_SESSION_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32

# --- Local deployment (LAN/Tailscale, no TLS, password only) ---
# See DEPLOY.md's local-deployment section for the full reasoning on why
# plain HTTP + a single shared password is the deliberate choice here.

# Host port the container binds to (same port inside and outside the
# container — see docker-compose.local.yml). Reachable at:
#   http://<server-lan-ip>:8286   (home network)
#   http://<server-tailscale-ip>:8286   (Tailscale, away from home)
PORT=8286

# The single shared password protecting the local deployment. Independent of
# KB_AUTH_HTPASSWD above — use a different password, since this is a
# separate login gate with its own trust model. Generate with:
#   docker run --rm httpd:2.4-alpine htpasswd -nbBC 12 familyuser 'YOUR_PASSWORD'
# Paste the full "familyuser:$2y$12$..." output below as-is.
NOTES_AUTH_HTPASSWD=familyuser:$2y$12$REPLACE_WITH_GENERATED_HASH

# Secret used to sign local-deployment session cookies. Generate with:
#   openssl rand -hex 32
# Independent of KB_SESSION_SECRET above — rotating this only logs out the
# local deployment's sessions.
NOTES_SESSION_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
